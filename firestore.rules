rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'interacaodigitall@gmail.com' ||
        request.auth.token.email == 'reputa@glowfyhub.com' ||
        request.auth.token.email == 'eunawebse@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin')
      );
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Users
    match /users/{userId} {
      allow read, write: if true;
    }

    // Businesses (Public can read by slug; merchants and admins can create/update/delete)
    match /businesses/{businessId} {
      allow read, write: if true;
    }

    // Reviews (Public can submit reviews; authenticated users/merchants can read and manage)
    match /reviews/{reviewId} {
      allow read, write: if true;
    }

    // Feedback (Public can submit feedback; authenticated users/merchants can read and manage)
    match /feedback/{feedbackId} {
      allow read, write: if true;
    }

    // Customers CRM (Public review submission upserts customers; merchants read and manage)
    match /customers/{customerId} {
      allow read, write: if true;
    }

    // Recovery Cases (Public submission creates cases; merchants read and manage)
    match /recovery_cases/{caseId} {
      allow read, write: if true;
    }

    // Interactions
    match /interactions/{interactionId} {
      allow read, write: if true;
    }

    // Plans
    match /plans/{planId} {
      allow read, write: if true;
    }

    // Settings
    match /settings/{settingId} {
      allow read, write: if true;
    }
  }
}

